<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:id="@+id/scrollWithdraw"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_pad"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/screen_pad"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStepPayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="PAYOUT"
                        android:textColor="@color/gold"
                        android:textSize="10sp" />

                    <View
                        android:id="@+id/barPayout"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStepDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="DETAILS"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <View
                        android:id="@+id/barDetails"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/stroke_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStepTransfer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="TRANSFER"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <View
                        android:id="@+id/barTransfer"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/stroke_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStepDone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="DONE"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <View
                        android:id="@+id/barDone"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/stroke_soft" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStepLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Step 1 of 4"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <!-- Step 1: payout -->
            <LinearLayout
                android:id="@+id/groupPayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.ATG.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="A withdrawal is a claim against money you have already taken out of your broker. Start with where you want it to land." />

                <TextView
                    style="@style/TextAppearance.ATG.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="PAY OUT TO" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPayoutMobile"
                    style="@style/Widget.ATG.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Mobile money number">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPayoutMobile"
                        style="@style/Widget.ATG.InputEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvPayoutHint"
                    style="@style/TextAppearance.ATG.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="The wallet the money lands in. Check this one twice." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContinue1"
                    style="@style/Widget.ATG.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="16dp"
                    android:text="Continue" />
            </LinearLayout>

            <!-- Step 2: details -->
            <LinearLayout
                android:id="@+id/groupDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFiledUnder"
                    style="@style/TextAppearance.ATG.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWithdrawAmount"
                    style="@style/Widget.ATG.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Amount in USD">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWithdrawAmount"
                        style="@style/Widget.ATG.InputEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvMinWithdraw"
                    style="@style/TextAppearance.ATG.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Minimum withdrawal is $12.50." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Withdrawal amount"
                            android:textColor="@color/ink_soft"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvWithdrawAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvWithdrawFeeLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Withdrawal charge (7%)"
                            android:textColor="@color/ink_soft"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvWithdrawFee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="- $0.00"
                            android:textColor="@color/gold"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/stroke_soft" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="You will receive"
                            android:textColor="@color/ink"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvYouReceive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textColor="@color/ink"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWithdrawMobile"
                    style="@style/Widget.ATG.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Your mobile number">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWithdrawMobile"
                        style="@style/Widget.ATG.InputEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/TextAppearance.ATG.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Where ATG will reach you about this withdrawal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContinue2"
                    style="@style/Widget.ATG.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="16dp"
                    android:text="Continue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack2"
                    style="@style/Widget.ATG.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="10dp"
                    android:text="Back" />
            </LinearLayout>

            <!-- Step 3: transfer -->
            <LinearLayout
                android:id="@+id/groupTransfer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.ATG.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="WHERE IT CAME OUT OF" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_badge_tile">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Transfer"
                                android:src="@drawable/ic_withdraw" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvInstructionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="Withdrawing through Weltrade"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvInstructionBody"
                        style="@style/TextAppearance.ATG.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWithdrawClientId"
                    style="@style/Widget.ATG.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Weltrade Client ID">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWithdrawClientId"
                        style="@style/Widget.ATG.InputEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvTransferHint"
                    style="@style/TextAppearance.ATG.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="In your Weltrade cabinet, under your name. It is not your MT5 login." />

                <TextView
                    style="@style/TextAppearance.ATG.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="PROOF OF WITHDRAWAL FROM THE AGENT" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChooseProof"
                    style="@style/Widget.ATG.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Choose a screenshot"
                    android:textColor="@color/gold"
                    app:backgroundTint="@color/primary_soft" />

                <TextView
                    android:id="@+id/tvProofName"
                    style="@style/TextAppearance.ATG.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="A screenshot of the broker confirmation. Withdrawals cannot be reviewed without it." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRequest"
                    style="@style/Widget.ATG.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="16dp"
                    android:text="Request $0.00" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack3"
                    style="@style/Widget.ATG.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="10dp"
                    android:text="Back" />
            </LinearLayout>

            <!-- Step 4: done -->
            <LinearLayout
                android:id="@+id/groupDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="30dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_circle_green">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="Filed"
                        android:src="@drawable/ic_check" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvDoneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Request filed"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDoneBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvDoneNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDone"
                    style="@style/Widget.ATG.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="24dp"
                    android:text="Done" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
