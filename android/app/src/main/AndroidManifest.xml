<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ATG"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ATG">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.AuthActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.MainActivity" />
        <activity android:name=".ui.DepositActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.WithdrawActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.PairDetailActivity" />
        <activity android:name=".ui.SignalDetailActivity" />
        <activity android:name=".ui.RoomDetailActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.AcademyActivity" />
        <activity android:name=".ui.CourseDetailActivity" />
        <activity android:name=".ui.LessonActivity" />
        <activity android:name=".ui.GlossaryActivity" />
        <activity android:name=".ui.PipCalculatorActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ProfileActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.AdminActivity" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
