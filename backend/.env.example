# ATG backend local configuration - loaded by EnvFileLoader at startup.
# Real .env files are gitignored: NEVER commit real keys. Real environment
# variables (e.g. on Render) always override values set here.

# --- Dischub payment gateway (https://dischub.co.zw) ---
# Gateway > Configurations in the Dischub dashboard.
# Non-redirect EcoCash integration (ecocash.md): no test mode, no callback
# URL and no redirect URL - the prompt goes to the customer's phone and the
# backend polls the status endpoint.
DISCHUB_API_KEY=
DISCHUB_RECIPIENT=

# --- Admin seeded on first boot (only when the database is empty) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=change-me

# --- Firebase ---
# The service account file is read from backend/keys/firebase-adminsdk.json
# (see app.firebase.service-account in application.properties). The storage
# bucket is derived from that key's project_id automatically - only set the
# line below to override it, e.g. for a bucket in another project.
# FIREBASE_STORAGE_BUCKET=
